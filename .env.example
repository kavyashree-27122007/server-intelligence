# Support Intelligence Configuration

# Selected Brand (Configurable across any brand in TWCS)
BRAND="SpotifyCares"
BRAND_HANDLE="SpotifyCares"

# Data Sampling (Reproducible Seed)
SAMPLE_SIZE=50000
RANDOM_SEED=42

# LLM Provider Selection: gemini | openai | mock
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-1.5-flash"

# API Keys (Provide one for live generation, or leave blank to use grounded synthesis fallback)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Vector Retrieval Configuration
EMBEDDING_MODEL="all-MiniLM-L6-v2"
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# Server Configuration
API_HOST="0.0.0.0"
API_PORT=8000
DEBUG=false
LOG_LEVEL="INFO"
